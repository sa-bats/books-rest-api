generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Author {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  birthYear   Int
  nationality String
  biography   String?
  createdAt   DateTime @default(now())
  books       Book[]
}

model Publisher {
  id          Int      @id @default(autoincrement())
  name        String
  country     String
  foundedYear Int
  website     String?
  createdAt   DateTime @default(now())
  books       Book[]
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id            Int       @id @default(autoincrement())
  title         String
  isbn          String    @unique
  publishedYear Int
  pageCount     Int
  language      String
  description   String
  coverImage    String?
  authorId      Int
  publisherId   Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  author        Author    @relation(fields: [authorId], references: [id])
  publisher     Publisher @relation(fields: [publisherId], references: [id])
  genres        Genre[]
  reviews       Review[]

  @@index([authorId])
  @@index([publisherId])
  @@index([publishedYear])
}

model Review {
  id        Int      @id @default(autoincrement())
  bookId    Int
  userName  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}
